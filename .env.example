# Copy to `.env` for local development. Never commit `.env`.
#
# Aurona Code is an open-source project: the Aurona Account client id is a
# public, per-build configuration value. Register your own public/native client
# in Aurona Account (XAdmin) with:
#   - redirect_uri: http://127.0.0.1/oauth/callback (dynamic loopback port)
#   - scopes: openid profile email offline_access
#   - PKCE: forced S256, grant: authorization_code refresh_token
# and then fill in the id below.
AURONA_ACCOUNT_CLIENT_ID=

# Optional debug-only overrides for local OIDC providers. The insecure
# loopback switch is honored only in debug builds; release builds always
# require HTTPS providers.
# AURONA_ACCOUNT_DISCOVERY_URL=http://127.0.0.1:5174/.well-known/openid-configuration
# AURONA_ACCOUNT_EXPECTED_ISSUER=http://127.0.0.1:5174
# AURONA_ACCOUNT_ALLOW_INSECURE_LOOPBACK_PROVIDER=1
