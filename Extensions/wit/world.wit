package aurona:extensions;

/// Host-provided context and capabilities for the extension.
interface context {
  record environment {
    theme: string,
    accent-color: string,
    color-scheme: string,
    locale: string,
    font-weight: string,
    font-size: string,
    app-version: string,
    platform: string,
  }

  record text-position {
    line: u32,
    character: u32,
  }

  record selection-range {
    start: text-position,
    end: text-position,
  }

  record editor-snapshot {
    path: option<string>,
    language: option<string>,
    content: option<string>,
    version: u64,
  }

  record workspace-info {
    has-workspace: bool,
    name: option<string>,
    root-name: option<string>,
  }

  record file-entry {
    name: string,
    is-directory: bool,
    size-bytes: u64,
  }

  record fliuno-item {
    id: string,
    title: string,
    subtitle: option<string>,
    icon: option<string>,
    action: string,
  }

  record git-repo-info {
    root: string,
    branch: string,
    ahead: u32,
    behind: u32,
    has-remote: bool,
  }

  record git-file-status {
    path: string,
    change: string,
    staged: bool,
  }

  record git-log-entry {
    hash: string,
    author: string,
    message: string,
    date: string,
  }

  record quick-pick-item {
    id: string,
    label: string,
    detail: option<string>,
    icon: option<string>,
  }

  enum permission-state {
    unknown,
    granted,
    denied,
  }

  /// Returns the current SDK Contract version (1).
  get-sdk-version: func() -> u32;

  get-environment: func() -> environment;

  /// Returns the current editor snapshot. Content is only included when the
  /// host has granted `editor.current.read`.
  get-editor-snapshot: func() -> editor-snapshot;

  /// Returns the current editor selection range when `editor.current.read` is granted.
  get-editor-selection: func() -> option<selection-range>;

  /// Returns the selected text in the active editor when `editor.current.read` is granted.
  get-editor-selection-text: func() -> option<string>;

  /// Returns workspace metadata when `workspace.read` is granted.
  get-workspace-info: func() -> workspace-info;

  /// Requests a permission by id (for example "editor.current.read").
  /// Returns the current state; the host decides whether the user is asked.
  request-permission: func(permission: string) -> permission-state;

  /// Reads a file inside the current workspace when `workspace.read` is
  /// granted. Paths are relative to the workspace root and are validated by
  /// the host against the workspace boundary.
  read-workspace-file: func(path: string) -> result<string, string>;

  /// Safely writes a text file inside the current workspace when `workspace.read`
  /// or write permission is granted. Enforces workspace boundary and path sanitization.
  write-workspace-file: func(path: string, content: string) -> result<bool, string>;

  /// Lists entries in a workspace directory (relative to workspace root) when
  /// `workspace.read` is granted. The host enforces workspace boundary and max count limit.
  list-workspace-files: func(directory: string, max-count: u32) -> result<list<file-entry>, string>;

  /// Requests the host to register a file or directory watcher within the workspace boundary.
  /// Returns a watch identifier handle when `workspace.read` is granted.
  watch-workspace-path: func(path: string) -> result<u64, string>;

  /// Unregisters an active workspace file watcher handle.
  unwatch-workspace-path: func(watch-id: u64) -> result<bool, string>;

  /// Sends a structured log message to the host standard logger for extension diagnostics.
  log: func(level: string, message: string);

  /// Shows a notification toast message in the host UI (info / warn / error / success).
  show-notification: func(level: string, message: string) -> result<bool, string>;

  /// Writes text content safely into the system clipboard.
  write-clipboard: func(text: string) -> result<bool, string>;

  /// Reads text content from the system clipboard.
  read-clipboard: func() -> result<string, string>;

  /// Returns official Tabler SVG content by icon name (e.g. "check", "trash", "clipboard").
  get-icon-svg: func(name: string) -> option<string>;

  /// Executes an Aurona Code built-in or extension command.
  execute-command: func(command-id: string, arguments: list<string>) -> result<string, string>;

  /// Sets a temporary status bar message with auto-dismiss timeout in milliseconds.
  set-status-message: func(message: string, timeout-ms: u32) -> result<bool, string>;

  /// Inserts text into current active editor at primary cursor position.
  insert-editor-text: func(text: string) -> result<bool, string>;

  /// Reveals specified line number in current active editor viewport.
  reveal-editor-line: func(line: u32) -> result<bool, string>;

  /// Contributes custom quick items into Fliuno Search (requires fliuno.search permission).
  contribute-fliuno-items: func(items: list<fliuno-item>) -> result<bool, string>;

  /// Returns repository metadata for the current workspace when `git.read` is
  /// granted. Returns none when the workspace is not a git repository.
  git-repository-info: func() -> option<git-repo-info>;

  /// Returns the changed files in the current workspace when `git.read` is granted.
  git-status: func() -> result<list<git-file-status>, string>;

  /// Returns recent commits (newest first, capped at `limit`) when `git.read` is granted.
  git-log: func(limit: u32) -> result<list<git-log-entry>, string>;

  /// Returns the worktree diff for one file (workspace-relative path) when
  /// `git.read` is granted.
  git-diff: func(path: string) -> result<string, string>;

  /// Stages the given files (workspace-relative paths) when `git.write` is granted.
  git-stage: func(paths: list<string>) -> result<bool, string>;

  /// Unstages the given files (workspace-relative paths) when `git.write` is granted.
  git-unstage: func(paths: list<string>) -> result<bool, string>;

  /// Commits staged changes with a message when `git.write` is granted.
  /// Empty messages are rejected by the host.
  git-commit: func(message: string) -> result<bool, string>;

  /// Reads an entry from the extension's dedicated isolated storage sandbox.
  storage-get: func(key: string) -> result<option<string>, string>;

  /// Writes an entry into the extension's dedicated isolated storage sandbox.
  storage-set: func(key: string, value: string) -> result<bool, string>;

  /// Deletes an entry from the extension's dedicated isolated storage sandbox.
  storage-delete: func(key: string) -> result<bool, string>;

  /// Lists all keys stored in the extension's dedicated isolated storage sandbox.
  storage-list-keys: func() -> result<list<string>, string>;

  /// Clears every entry in the extension's dedicated isolated storage sandbox.
  storage-clear: func() -> result<bool, string>;

  /// Displays an interactive modal confirmation dialog with the user.
  show-dialog-confirm: func(title: string, message: string) -> result<bool, string>;

  /// SDK v1 增量（0.4.6）：以下方法为纯增量扩展，旧扩展组件不受影响。

  /// Reads up to `length` UTF-8-safe characters of a workspace file starting
  /// at byte `offset` when `workspace.read` is granted. Enables chunked reads
  /// of large files without loading them entirely into memory.
  read-workspace-range: func(path: string, offset: u64, length: u32) -> result<string, string>;

  /// Returns metadata (name / size / is-directory) for a workspace-relative
  /// path when `workspace.read` is granted.
  get-workspace-file-metadata: func(path: string) -> result<file-entry, string>;

  /// Shows a single-line text input modal. Resolves with the user's input, or
  /// none when the dialog is cancelled. Blocks the caller until the user acts
  /// or the host timeout expires.
  show-input-box: func(title: string, placeholder: string) -> result<option<string>, string>;

  /// Shows a quick-pick list modal. Resolves with the chosen item's id, or
  /// none when the dialog is cancelled.
  show-quick-pick: func(items: list<quick-pick-item>, title: string, placeholder: string) -> result<option<string>, string>;

  /// Drains host-pushed events for this extension (document changes, saves,
  /// workspace switches). Events are plain strings, most-recent last; each is
  /// delivered exactly once. The queue is capped by the host.
  poll-events: func() -> list<string>;
}

/// The extension's render contract.
interface render {
  record render-input {
    markdown: string,
  }

  record render-output {
    html: string,
    diagnostics: list<string>,
  }

  render: func(input: render-input) -> result<render-output, string>;

  /// Handles a UI action emitted by the rendered view (request-response model).
  /// Extensions are stateless across calls: persist anything long-lived via the
  /// storage API. The host passes the user's action and an opaque payload, and
  /// the extension returns the next render output.
  ///
  /// Backwards compatibility: components compiled against earlier revisions of
  /// this world do not export `on-action`. The host treats the export as
  /// optional and surfaces a clear error when such extensions receive actions.
  on-action: func(action-id: string, payload: string) -> result<render-output, string>;
}

world aurona-extension {
  import context;
  export render;
}
