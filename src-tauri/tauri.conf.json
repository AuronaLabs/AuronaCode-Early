{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aurona Code",
  "mainBinaryName": "Aurona Code",
  "version": "0.4.11",
  "identifier": "com.aurona.code",
  "build": {
    "features": [
      "aurona-account"
    ],
    "beforeDevCommand": "pnpm run prepare:extensions && pnpm run dev",
    "beforeBuildCommand": "pnpm run prepare:extensions && pnpm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../Dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "/splash.html",
        "title": "Aurona Code Initializing",
        "width": 500,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "Aurona Code",
        "width": 1440,
        "height": 920,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "maximized": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:; img-src 'self' data: blob: https: http://127.0.0.1:*; connect-src ipc: http://ipc.localhost http://tauri.localhost https://tauri.localhost https://marketplace.aurona.cc https://auth.aurona.cc https://account.aurona.cc https://github.com https://api.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com http://127.0.0.1:* http://localhost:*",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRjQxOURGODdCQ0I1MzIKUldReXRieUgzeG4wNzFtWi8vMXZxbVNvbC9aeXhjU2VuYlM4bVQrS3ZUeW1VdEdvRzBwRnlsQlIK",
      "endpoints": [
        "https://github.com/AuronaLabs/AuronaCode-Early/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "../LICENSE",
    "resources": {
      "resources/extensions/": "extensions/",
      "resources/extensions-demo/": "extensions-demo/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English",
          "Japanese",
          "Italian",
          "German"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {}
    }
  }
}
